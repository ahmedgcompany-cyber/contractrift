# Copy to .env and adjust. Every variable is documented in DEVELOPER_GUIDE.md.

# Required. 32 random bytes, base64. Generate with: npm run gen-key
# Encrypts monitor secrets and channel URLs at rest. Losing it makes stored secrets unreadable.
ENCRYPTION_KEY=
# During key rotation: the old key(s), comma-separated. Secrets are re-encrypted at startup.
# ENCRYPTION_KEY_PREVIOUS=

# development | production | test
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Public URL users open (used for links in notifications and CSRF origin checks).
APP_URL=http://localhost:3000

# PostgreSQL connection string. Leave empty to use embedded PGlite stored in PGLITE_DATA_DIR.
DATABASE_URL=
# PGLITE_DATA_DIR=./data/pglite

# Session lifetime (sliding), hours.
SESSION_TTL_HOURS=168
# Secure cookies; defaults to true when NODE_ENV=production. Requires HTTPS.
# COOKIE_SECURE=
# Set true when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Per-IP limit for login/setup/password-change requests per minute.
AUTH_RATE_LIMIT_PER_MINUTE=10

# Protects first-run setup on internet-facing installs: the admin account can only be created with this value.
# SETUP_TOKEN=

# Public read-only demo (shared viewer account + demo monitors against real public services).
# DEMO_MODE=false
# DEMO_EMAIL=demo@contractrift.dev
# DEMO_PASSWORD=contractrift-demo
LOG_LEVEL=info

# Allow monitors/webhooks to reach private, loopback and link-local addresses.
# Keep false unless you intentionally monitor internal services (SSRF risk).
ALLOW_PRIVATE_TARGETS=false

SCHEDULER_ENABLED=true
SCHEDULER_CONCURRENCY=8
SCHEDULER_TICK_MS=5000
RETENTION_DAYS=30

# Directory with the built frontend (default: frontend/dist). Set to an empty value to serve the API only.
# FRONTEND_DIST=
