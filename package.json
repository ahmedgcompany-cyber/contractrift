{
  "name": "contractrift",
  "version": "0.3.1",
  "private": true,
  "description": "Self-hosted monitor that detects when the REST APIs, LLM APIs and MCP servers you depend on go down or silently change.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev -w backend",
    "dev:web": "npm run dev -w frontend",
    "build": "npm run build -w frontend && npm run build -w backend",
    "start": "npm run start -w backend",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "npm run test -w backend",
    "test:unit": "npm run test:unit -w backend",
    "test:integration": "npm run test:integration -w backend",
    "test:e2e": "playwright test",
    "db:generate": "npm run db:generate -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "openapi": "npm run openapi -w backend",
    "gen-key": "node scripts/gen-key.mjs",
    "gate": "node scripts/contractrift-gate.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ahmedgcompany-cyber/contractrift.git"
  },
  "homepage": "https://github.com/ahmedgcompany-cyber/contractrift",
  "keywords": [
    "api-monitoring",
    "schema-drift",
    "contract-testing",
    "mcp",
    "llm",
    "observability",
    "self-hosted",
    "synthetic-monitoring",
    "api-drift",
    "model-context-protocol"
  ]
}
